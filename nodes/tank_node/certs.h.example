// DOMORA TANK node — TLS identity template.
//
// Copy to certs.h (gitignored) and paste in this node's PKI files:
//
//   python -m tools.gen_certs --out certs --nodes fp1 fp2 env1 perc1
//
// CA_CERT      <- certs/ca.pem   (shared house CA)
// CLIENT_CERT  <- certs/fp2.pem  (this node's identity — CN "fp2" doubles
//                                 as the broker ACL username)
// CLIENT_KEY   <- certs/fp2.key  (this node's private key)

#pragma once

static const char CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE certs/ca.pem HERE
-----END CERTIFICATE-----
)EOF";

static const char CLIENT_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE certs/fp2.pem HERE
-----END CERTIFICATE-----
)EOF";

static const char CLIENT_KEY[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
PASTE certs/fp2.key HERE
-----END RSA PRIVATE KEY-----
)EOF";
